{
  "name": "coinpeas-static",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/fetch-coins.mjs data/coins.json --if-missing",
    "dev": "vite",
    "prebuild": "node scripts/fetch-coins.mjs data/coins.json --if-missing",
    "build": "vite build",
    "preview": "vite preview",
    "fetch-coins": "node scripts/fetch-coins.mjs data/coins.json",
    "deploy": "npm run fetch-coins && npm run build && wrangler deploy --message \"Manual deploy\"",
    "deploy-cron": "wrangler deploy --config cron/wrangler.jsonc"
  },
  "devDependencies": {
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  }
}
