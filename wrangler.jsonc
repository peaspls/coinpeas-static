{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coinpeas",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./dist"
  },

  // Served on the apex domain only. No `www` route/redirect.
  "routes": [
    {
      "pattern": "coinpeas.com",
      "custom_domain": true
    }
  ]
}
